# ---------------------------------------------------------------------------
# Copy this file to server/.env and fill in the blanks. .env is gitignored;
# this example is committed so collaborators know which keys they need.
#
# DEPLOYING: there is no .env on the API host — set every key below in the
# host's environment-variable UI (Render: Settings -> Environment) instead.
# Only MONGODB_URI and JWT_SECRET are enforced; the server refuses to boot
# without them (index.js -> env.assertRequired()). The rest fall back to
# development-friendly defaults, so a forgotten key fails quietly rather than
# loudly — CLIENT_ORIGIN especially, see below.
# ---------------------------------------------------------------------------

# Local only. Render/Railway/Fly inject PORT themselves — do not set it there,
# and do not hardcode it in code; the server already reads whatever it is given.
PORT=5000

# Set NODE_ENV=production on the API host. It also suppresses stack traces in
# error responses (src/middleware/errorHandler.js).
NODE_ENV=development

# Origin(s) allowed to call this API. Comma-separated. 5173 is the Vite dev server.
# Left unset it silently falls back to localhost and the deployed client's
# socket connection is refused by CORS, so set it explicitly on the API host.
#
# An entry may contain a `*` standing in for ONE hostname label, which is how
# Vercel preview builds — each on a generated subdomain nobody can list in
# advance — are allowed in without opening the API to every site on vercel.app:
#
#   CLIENT_ORIGIN=https://collab-board-six-kappa.vercel.app,https://collab-board-*.vercel.app
#
# Keep the pattern as narrow as the deployment allows; `https://*.vercel.app`
# would admit anyone's project.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas — Clusters -> Connect -> Drivers -> Node.js.
# Replace <db_password> with the database user's password (percent-encode
# @ : / ? # [ ] % if it contains any).
MONGODB_URI=mongodb+srv://collabboard_app:<db_password>@collabboard-cluster.xxxxx.mongodb.net/collabboard?retryWrites=true&w=majority&appName=collabboard-cluster
MONGODB_DB=collabboard

# Auth. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# The one account allowed to create and delete boards (its username).
ADMIN_USERNAME=dilan_amantha

# Swagger UI at /api/docs, on by default. Set to false to keep the interactive
# docs off a public deployment.
ENABLE_API_DOCS=true
