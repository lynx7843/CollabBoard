# ---------------------------------------------------------------------------
# Copy this file to server/.env and fill in the blanks. .env is gitignored;
# this example is committed so collaborators know which keys they need.
# ---------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# Origin(s) allowed to call this API. Comma-separated. 5173 is the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas — Clusters -> Connect -> Drivers -> Node.js.
# Replace <db_password> with the database user's password (percent-encode
# @ : / ? # [ ] % if it contains any).
MONGODB_URI=mongodb+srv://collabboard_app:<db_password>@collabboard-cluster.xxxxx.mongodb.net/collabboard?retryWrites=true&w=majority&appName=collabboard-cluster
MONGODB_DB=collabboard

# Auth. Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# The one account allowed to create and delete boards (its username).
ADMIN_USERNAME=dilan_amantha

# Swagger UI at /api/docs, on by default. Set to false to keep the interactive
# docs off a public deployment.
ENABLE_API_DOCS=true
