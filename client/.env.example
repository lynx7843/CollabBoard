# ---------------------------------------------------------------------------
# Copy this file to client/.env and adjust. .env is gitignored; this example is
# committed so collaborators know which keys exist.
#
# Vite only exposes variables prefixed with VITE_, and it BAKES THEM INTO THE
# BUNDLE AT BUILD TIME. Changing one needs a rebuild (locally) or a redeploy
# (on Vercel) — restarting the host does nothing. Never put a secret in here:
# everything below ships to the browser in plain text.
# ---------------------------------------------------------------------------

# Presentation stub layer (client/src/demo/demoMode.js). Off unless set to
# exactly 'true'. While on, login accepts hard-coded credentials with no server,
# so leave it off for anything deployed.
VITE_DEMO_MODE=false

# Origin of the API server, used by the Socket.IO connection (client/src/socket.js).
# REST calls use relative /api paths, handled by the Vite dev proxy locally and
# by the Vercel rewrite in production — but a WebSocket cannot go through that
# rewrite, so this must point straight at the API host in a deployed build.
#   local:  http://localhost:5000
#   Vercel: https://syncspace-api-rxhi.onrender.com
VITE_API_URL=http://localhost:5000
